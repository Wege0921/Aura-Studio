// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  bookings                Booking[]
  userPackages            UserPackage[]
  payments                Payment[]
  waitlistEntries         WaitlistEntry[]
  reviews                 Review[]
  pushSubscriptions       PushSubscription[]
  notificationPreference  NotificationPreference?
  shopOrders              ShopOrder[]
  wishlist                Wishlist[]

  @@map("users")
}

model Class {
  id          String   @id @default(cuid())
  name        String
  description String?
  instructor  String
  date        DateTime
  time        String
  duration    Int
  capacity    Int
  classType   String   @default("PILATES")
  price       Float?
  imageUrl    String?
  isActive    Boolean  @default(true)
  hideInstructor Boolean @default(false)
  hideSpots      Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  bookings         Booking[]
  waitlistEntries  WaitlistEntry[]
  reviews          Review[]

  @@index([date])
  @@index([isActive])
  @@index([classType])
  @@map("classes")
}

model Booking {
  id          String    @id @default(cuid())
  userId      String?
  classId     String
  guestToken  String?   @unique
  status      String    @default("CONFIRMED")
  cancelledAt DateTime?
  paymentStatus String  @default("PENDING") // PENDING, PAID, FAILED
  paymentMethod String? // BANK_TRANSFER, MOBILE_MONEY, CASH
  paymentAmount Float?
  paymentReceiptUrl String?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userPackageId String?

  // Relations
  user       User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  class      Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  userPackage UserPackage? @relation(fields: [userPackageId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([status])
  @@index([userId])
  @@index([classId])
  @@index([guestToken])
  @@map("bookings")
}

model Package {
  id            String   @id @default(cuid())
  name          String
  description   String?
  sessionsCount Int
  price         Float
  validityDays  Int?
  classType     String   @default("ALL")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  userPackages UserPackage[]
  payments     Payment[]

  @@map("packages")
}

model UserPackage {
  id                String    @id @default(cuid())
  userId            String
  packageId         String
  remainingSessions Int
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  source        String    @default("PURCHASE") // PURCHASE, ADMIN_GRANT, PROMOTION

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([userId])
  @@index([expiresAt])
  @@map("user_packages")
}

model Payment {
  id            String    @id @default(cuid())
  userId        String
  amount        Float
  paymentMethod String    @default("BANK_TRANSFER")
  receiptUrl    String?
  status        String    @default("PENDING")
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  packageId     String?

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  package Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@index([paymentMethod])
  @@map("payments")
}

model WaitlistEntry {
  id          String    @id @default(cuid())
  userId      String
  classId     String
  position    Int       @default(0)
  status      String    @default("WAITING") // WAITING, PROMOTED, CANCELLED
  promotedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([userId, classId])
  @@index([classId])
  @@index([status])
  @@map("waitlist_entries")
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  classId   String
  rating    Int      @default(5)
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([userId, classId])
  @@map("reviews")
}

model PushSubscription {
  id             String   @id @default(cuid())
  userId         String
  endpoint       String   @unique
  p256dh         String
  auth           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

model NotificationPreference {
  id                String  @id @default(cuid())
  userId            String  @unique
  bookingReminders  Boolean @default(true)
  classReminders    Boolean @default(true)
  paymentConfirmations Boolean @default(true)
  promotionalOffers Boolean @default(false)
  newsletter        Boolean @default(false)

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model SiteContent {
  section   String   @id
  data      Json
  updatedAt DateTime @updatedAt

  @@map("site_content")
}

// ============================================================
// SHOP MODULE — additive, does not touch existing tables
// ============================================================

model ProductCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]

  @@map("shop_categories")
}

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String?
  categoryId   String
  basePrice    Float
  salePrice    Float?
  sku          String?  @unique
  status       String   @default("ACTIVE") // ACTIVE, DRAFT, ARCHIVED, OUT_OF_STOCK
  isFeatured   Boolean  @default(false)
  weightGrams  Int?
  // Product-level stock for simple products (no variants).
  // When null, the product is treated as unlimited / not tracked at the
  // product level (variant stock is used instead, if any).
  stock        Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category     ProductCategory   @relation(fields: [categoryId], references: [id])
  variants     ProductVariant[]
  images       ProductImage[]
  orderItems   ShopOrderItem[]
  wishlist     Wishlist[]

  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@map("shop_products")
}

model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  size         String?
  color        String?
  style        String?
  sku          String?  @unique
  priceDelta   Float    @default(0)
  stock        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product      Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems   ShopOrderItem[]

  @@index([productId])
  @@map("shop_product_variants")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("shop_product_images")
}

model ShopOrder {
  id               String    @id @default(cuid())
  orderNumber      String    @unique
  userId           String?
  guestToken       String?
  status           String    @default("PENDING") // PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED, REFUNDED
  subtotal         Float
  shippingCost     Float     @default(0)
  discount         Float     @default(0)
  total            Float
  paymentMethod    String?   // BANK_TRANSFER, MOBILE_MONEY, CASH_ON_DELIVERY
  paymentReceiptUrl String?
  paymentStatus    String    @default("PENDING") // PENDING, VERIFIED, REJECTED
  paidAt           DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  items            ShopOrderItem[]
  shippingAddress  ShippingAddress?
  statusHistory    ShopOrderStatusHistory[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([guestToken])
  @@map("shop_orders")
}

model ShopOrderItem {
  id           String   @id @default(cuid())
  orderId      String
  productId    String
  variantId    String?
  name         String   // snapshot at purchase time
  variantLabel String?  // "M / Black"
  unitPrice    Float    // snapshot
  quantity     Int
  lineTotal    Float

  order        ShopOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product           @relation(fields: [productId], references: [id])
  variant      ProductVariant?   @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("shop_order_items")
}

model ShippingAddress {
  id         String   @id @default(cuid())
  orderId    String   @unique
  fullName   String
  phone      String
  region     String
  city       String
  address    String
  postalCode String?
  notes      String?

  order      ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("shop_shipping_addresses")
}

model ShopOrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  note      String?
  changedBy String?
  createdAt DateTime @default(now())

  order     ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("shop_order_status_history")
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("shop_wishlist")
}
